# ---------------------------------------------------------------------------
# Hospeda — Valores por defecto para `next dev`
# Se versiona en git: NO poner secretos reales aquí.
# `.env.local` tiene prioridad sobre este archivo y puede sobrescribir todo.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_TIMEOUT=15000

AUTH_COOKIE_NAME=hospeda_token
AUTH_SESSION_MAX_AGE=604800
AUTH_MODE=mock
