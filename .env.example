# Hospeda — configuración del frontend y del proxy server-side.
# No agregues esta URL como NEXT_PUBLIC_: solo el Route Handler la usa.
API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=15000

# Compatibilidad temporal: el proxy también puede leer NEXT_PUBLIC_API_URL en
# despliegues aún no migrados, pero las configuraciones nuevas deben usar API_URL.

# Contrato esperado del backend
# POST   /auth/login
# POST   /auth/logout
# GET    /auth/me
# GET    /dashboard
# GET    /properties
# GET/POST/PUT/DELETE /property-types
# GET/POST/PUT/DELETE /colonies
# GET    /locations/countries, /locations/states, /locations/cities
# GET/PATCH /users/me
