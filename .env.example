# Hospeda — configuración del frontend y conexión directa con la API.
# API_URL es opcional y solo se usa por el proxy legado del servidor.
API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fallback para renderizado en servidor y despliegues existentes.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_TIMEOUT=15000

# Contrato esperado del backend
# POST   /auth/login
# POST   /auth/logout
# GET    /auth/me
# GET    /dashboard
# GET    /properties
# GET/POST/PUT/DELETE /property-types
# GET/POST/PUT/DELETE /colonies
# GET    /locations/countries, /locations/states, /locations/cities
# GET/PATCH /users/me
