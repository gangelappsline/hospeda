# ---------------------------------------------------------------------------
# Hospeda — Plantilla de variables de entorno
# Copia este archivo como `.env.local` y rellena los valores reales.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Entorno lógico de la app (local | development | staging | production)
NEXT_PUBLIC_APP_ENV=local

# URL pública donde corre el frontend (usada en enlaces absolutos y callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL base del backend de Hospeda, sin slash final.
# El cliente HTTP le antepone esto a cada endpoint: `${API_URL}/auth/login`
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Timeout (ms) para las peticiones salientes hacia la API
NEXT_PUBLIC_API_TIMEOUT=15000

# ------------------------- Solo servidor (secretos) ------------------------
# Nunca prefijar con NEXT_PUBLIC_: estas variables no llegan al navegador.

# Nombre de la cookie httpOnly donde se guarda el token de sesión
AUTH_COOKIE_NAME=hospeda_token

# Duración de la sesión en segundos (7 días por defecto)
AUTH_SESSION_MAX_AGE=604800

# Secreto usado para firmar/verificar los tokens emitidos en modo mock
AUTH_SECRET=cambia-este-valor-por-uno-aleatorio-largo

# Modo de autenticación:
#   mock  -> usa usuarios de prueba locales (no requiere backend levantado)
#   api   -> delega el login al backend real en NEXT_PUBLIC_API_URL
AUTH_MODE=mock
