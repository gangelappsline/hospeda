# ---------------------------------------------------------------------------
# Hospeda — Valores por defecto para `next build` / `next start`
# Se versiona en git: NO poner secretos reales aquí.
# Los secretos (AUTH_SECRET, llaves de terceros) se inyectan desde el panel de
# variables de entorno del hosting (Vercel / Docker / CI) o desde
# `.env.production.local`, que está en .gitignore.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://hospeda.com
NEXT_PUBLIC_API_URL=https://api.hospeda.com/api
NEXT_PUBLIC_API_TIMEOUT=20000

AUTH_COOKIE_NAME=hospeda_token
AUTH_SESSION_MAX_AGE=604800
AUTH_MODE=api

# AUTH_SECRET se define como secreto en el hosting, no aquí.
